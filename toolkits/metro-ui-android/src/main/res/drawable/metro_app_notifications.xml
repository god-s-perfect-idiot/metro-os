        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.72"
        android:scaleY="0.72">
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M30,32 H78 V76 H30 Z
                M36,40 H54 V52 H36 Z
                M58,40 H72 V44 H58 Z
                M58,48 H72 V52 H58 Z
                M36,58 H72 V62 H36 Z
