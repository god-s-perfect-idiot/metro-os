<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Suite splash: full-bleed accent + app glyph (ic_launcher_foreground, merged from app).
      Point the launcher Activity at Theme.Metro.Splash (or an accent variant) and call
      MetroSplash.install() before super.onCreate().
    -->
    <style name="Theme.Metro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/metro_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Metro</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
    </style>

